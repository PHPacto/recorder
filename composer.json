{
  "name": "phpacto/recorder",
  "description": "Contract testing tool integrated with Guzzle and Phpunit",
  "license": "GPL-3.0",
  "type": "project",
  "authors": [
    {
      "name": "Damian D\u0142ugosz",
      "email": "bigfootdd@gmail.com",
      "homepage": "https://github.com/bigfoot90"
    }
  ],
  "require": {
    "php": ">=8.2",
    "bigfoot90/phpacto": "1.0.6",
    "laminas/laminas-diactoros": "^3.9",
    "nyholm/psr7": "^1.8",
    "php-http/curl-client": "^2.1",
    "php-http/discovery": "^1.12"
  },
  "require-dev": {
    "laminas/laminas-httphandlerrunner": "*",
    "laminas/laminas-stratigility": "^3.3",
    "mikey179/vfsstream": "^1.6.7",
    "phpunit/phpunit": "^9.6"
  },
  "config": {
    "preferred-install": "dist",
    "sort-packages": true,
    "advisories": {
      "block": false
    },
    "audit": {
      "block-insecure": false
    },
    "allow-plugins": {
      "php-http/discovery": true
    }
  },
  "autoload": {
    "psr-4": {
      "PHPacto\\Recorder\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "PHPacto\\Recorder\\": "tests/"
    }
  }
}
